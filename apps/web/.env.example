# ==============================================================================
# EduTrack — EXAMPLE ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# This file is safe to commit. Use this as a template for your local and production envs.
#
# PAYMENT MODEL NOTE: EduTrack uses the Blind Verification / Two-Independent-Witness
# reconciliation model. There are NO payment gateway API keys in this file.
# No STK Push, no Daraja OAuth, no Stripe, no Paystack — payers paste their own
# transaction SMS/notification; the engine reconciles metadata blindly.

# 1. Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 2. App URL (Use localhost:3000 for local dev, or your real domain for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. Web Push VAPID Keys (for Notifications)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@edutrack.co.ke

# 4. Master Admin / Platform Owner configuration
PRODUCT_ADMINISTRATOR_EMAIL=admin@edutrack.co.ke
BOOTSTRAP_SECRET=your_secret_string_here

# 5. Database direct connection (useful for CLI/migrations, reserved for local use typically)
SUPABASE_DB_PASSWORD=your_db_password
